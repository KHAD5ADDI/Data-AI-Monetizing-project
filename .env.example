# Copy to ".env.local" (or configure in Vercel Project Settings). Never commit real keys.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown)
VERBATIM_QUICK_MODEL=claude-haiku-5-5
VERBATIM_ANALYSIS_MODEL=claude-sonnet-5-5

# Daily cap on live claim-by-claim analyses per serverless instance
MAX_LIVE_CALLS_PER_DAY=300
